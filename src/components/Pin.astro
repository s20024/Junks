---
// 押しピン(装飾)。色・位置・サイズは親要素の CSS 変数で調整する:
//   --pin-c: ピンの色 / --pin-dark: 縁の影色 / --pin-x: 左右位置 / --pin-size: 直径
---

<span class="pin" aria-hidden="true"></span>

<style>
  .pin {
    position: absolute;
    z-index: 1;
    top: -0.45rem;
    left: var(--pin-x, 50%);
    width: var(--pin-size, 1.05rem);
    height: var(--pin-size, 1.05rem);
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.75) 0 14%, transparent 42%),
      radial-gradient(
        circle at 50% 50%,
        var(--pin-c, var(--accent)) 0 58%,
        var(--pin-dark, #8c1f19) 100%
      );
    box-shadow:
      0 2px 2px rgba(61, 41, 20, 0.45),
      0 6px 7px -2px rgba(61, 41, 20, 0.35);
    transform: translateX(-50%);
  }
</style>
