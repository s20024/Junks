---
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import path from 'node:path';
import Card from '../components/Card.astro';
import Pin from '../components/Pin.astro';
import corkGrainFine from '../assets/textures/cork-grain-fine.svg';
import corkChips from '../assets/textures/cork-chips.svg';
import corkMottle from '../assets/textures/cork-mottle.svg';
import paper from '../assets/textures/paper.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${base}${p}`;

// テクスチャSVGは CSS 変数として <html> に渡し、各所の CSS から参照する
const textureVars = [
  `--tex-cork-fine: url('${corkGrainFine.src}')`,
  `--tex-cork-chips: url('${corkChips.src}')`,
  `--tex-cork-mottle: url('${corkMottle.src}')`,
  `--tex-paper: url('${paper.src}')`,
].join('; ');

// 表示は date の降順
const entries = await getCollection('junks');
const items = [...entries]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({
    ...entry,
    // サムネイルはビルド時に実在チェック。無い間はフォールバック表示
    hasThumb: existsSync(path.join(process.cwd(), 'public', entry.data.thumbnail)),
  }));
---

<!doctype html>
<html lang="ja" style={textureVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="s20024(やら)のガラクタ置き場。勉強のために作ったものたちを置いています。"
    />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase('/logo.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>Junks</title>
  </head>
  <body>
    <header class="site-header">
      <Pin />
      <div class="site-heading">
        <h1 class="site-title">Junks</h1>
        <div class="site-intro">
          <p class="site-desc">
            s20024(やら)のガラクタ置き場。勉強のために作ったものたちを置いています。<br />
            小さなシンプルな練習作や、不要になったプロジェクトです。
          </p>
          <p class="site-meta">全 {items.length} 点</p>
        </div>
        <img
          class="site-logo"
          src={withBase('/logo.svg')}
          alt=""
          width="96"
          height="96"
        />
      </div>
    </header>

    <main>
      <ul class="grid">
        {
          items.map((item) => (
            <li>
              <Card
                title={item.data.title}
                description={item.data.description}
                href={withBase(item.data.url)}
                thumbSrc={item.hasThumb ? withBase(item.data.thumbnail) : null}
                date={item.data.date}
                tags={item.data.tags}
              />
            </li>
          ))
        }
      </ul>
    </main>

    <footer class="site-footer">
      <Pin />
      <p>Junks — 勉強のために作ったものたちの置き場</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #f4f1ea;
    --card: #ffffff;
    --ink: #2b2926;
    --ink-weak: #6f6a61;
    --line: #d9d3c6;
    --accent: #d0342c;
    --cork: #c49a6d;
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas,
      monospace;
    --sans: 'Noto Sans JP', system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    /* コルクボード: 地色 + 細かいノイズ + チップ粒 + 粗いムラ + 濃淡の斑点 */
    background-color: var(--cork);
    background-image:
      var(--tex-cork-fine),
      var(--tex-cork-chips),
      var(--tex-cork-mottle),
      radial-gradient(rgba(255, 244, 222, 0.3) 1.6px, transparent 2.1px),
      radial-gradient(rgba(97, 64, 32, 0.36) 1.4px, transparent 1.9px),
      radial-gradient(rgba(72, 45, 20, 0.28) 2.6px, transparent 3.3px),
      radial-gradient(rgba(255, 240, 214, 0.2) 3px, transparent 3.8px);
    background-size:
      180px 180px,
      220px 220px,
      260px 260px,
      15px 15px,
      22px 22px,
      57px 57px,
      73px 73px;
    background-position:
      0 0,
      0 0,
      0 0,
      0 0,
      7px 11px,
      23px 31px,
      41px 9px;
  }

  body {
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
    max-width: 72rem;
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ヘッダー: ボードに貼られた案内の紙 */
  .site-header {
    position: relative;
    margin-bottom: 2.5rem;
    padding: 1.5rem 1.75rem 1.25rem;
    background-color: #fffdf6;
    background-image: var(--tex-paper);
    border: 1px solid var(--line);
    box-shadow:
      0 5px 12px rgba(61, 41, 20, 0.3),
      inset 0 0 18px rgba(61, 41, 20, 0.07);
    transform: rotate(-0.3deg);
  }

  /* PC: テキスト左・ロゴ右 */
  .site-heading {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'title logo'
      'intro logo';
    align-items: center;
    column-gap: 1.5rem;
  }

  .site-title {
    grid-area: title;
    align-self: end;
  }

  .site-intro {
    grid-area: intro;
  }

  /* ポンコツロボット。少しだけ傾けてガラクタ感 */
  .site-logo {
    grid-area: logo;
    width: 8.5rem;
    height: auto;
    margin-right: 1.25rem;
    transform: rotate(4deg);
  }

  /* スマホ: 1行目「ロゴ + タイトル」、2行目に説明(全幅) */
  @media (max-width: 36rem) {
    .site-heading {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'logo title'
        'intro intro';
      column-gap: 1rem;
      row-gap: 0.5rem;
    }

    .site-title {
      align-self: center;
    }

    .site-logo {
      width: 4.75rem;
      margin-right: 0;
    }
  }

  .site-title {
    margin: 0;
    font-family: var(--mono);
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .site-desc {
    margin: 0.25rem 0 0;
    color: var(--ink-weak);
  }

  .site-meta {
    margin: 0.75rem 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-weak);
  }

  /* グリッド: PC 3列 / タブレット 2列 / スマホ 1列 */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5rem 2rem;
    margin: 0;
    padding: 0.75rem 0 0;
    list-style: none;
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  /* hover 時に傾く方向・角度はカードごとに変える(通常時は整列) */
  .grid li:nth-child(5n + 1) {
    --tilt: -2.1deg;
  }
  .grid li:nth-child(5n + 2) {
    --tilt: 1.6deg;
  }
  .grid li:nth-child(5n + 3) {
    --tilt: -1.3deg;
  }
  .grid li:nth-child(5n + 4) {
    --tilt: 2.2deg;
  }
  .grid li:nth-child(5n) {
    --tilt: -1.7deg;
  }

  /* ピンの色と刺す位置、紙の日焼け具合 */
  .grid li:nth-child(3n + 1) {
    --pin-c: #d0342c; /* 朱 */
    --pin-dark: #8c1f19;
    --card-tint: #fffdf6;
  }
  .grid li:nth-child(3n + 2) {
    --pin-c: #3f6e8c; /* 青 */
    --pin-dark: #27485d;
    --card-tint: #fbf5e8;
  }
  .grid li:nth-child(3n) {
    --pin-c: #c99c27; /* からし */
    --pin-dark: #8a691a;
    --card-tint: #f7efdd;
  }

  /* うっすらシミ */
  .grid li:nth-child(4n + 2) {
    --stain: radial-gradient(
      2rem 1.4rem at 84% 10%,
      rgba(150, 110, 60, 0.12),
      transparent 70%
    );
  }
  .grid li:nth-child(4n) {
    --stain: radial-gradient(
      2.4rem 1.7rem at 10% 90%,
      rgba(150, 110, 60, 0.1),
      transparent 70%
    );
  }

  /* フッター: 小さな紙切れ */
  .site-footer {
    position: relative;
    width: fit-content;
    margin: 3.5rem auto 0;
    padding: 0.6rem 1.2rem;
    background-color: #fbf5e8;
    background-image: var(--tex-paper);
    border: 1px solid var(--line);
    box-shadow: 0 4px 9px rgba(61, 41, 20, 0.28);
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-weak);
    transform: rotate(0.6deg);
    --pin-c: #3f6e8c;
    --pin-dark: #27485d;
    --pin-size: 0.9rem;
  }

  .site-footer p {
    margin: 0;
  }
</style>
